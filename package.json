    "pino": "^8.16.1",
    "pino-pretty": "^10.2.0",
    "sql.js": "^1.15.2",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  }
}
